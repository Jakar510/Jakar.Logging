<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Types stay in the Jakar.Extensions namespace, as every package split out of Jakar.Extensions does (MigrationPlan.md). -->
		<RootNamespace>Jakar.Extensions</RootNamespace>
		<AssemblyName>Jakar.Logging</AssemblyName>
		<Version>10.2.0</Version>
		<Title>Jakar.Logging</Title>
		<PackageId>Jakar.Logging</PackageId>
		<Authors>Tyler Stegmaier</Authors>
		<Description>Serilog and Microsoft.Extensions.Logging support: app logger options, OpenTelemetry activity enrichment, thread and GC properties, screenshots and scopes. No dependency on Jakar.Extensions (Jakar.Logging.Serilog adds that integration).</Description>
		<PackageTags>logging serilog opentelemetry file-logger enricher</PackageTags>
		<PackageReleaseNotes>10.2.0: BREAKING: no longer depends on Jakar.Extensions or Jakar.Files (Serilog, Microsoft.Extensions.Logging.Abstractions/Options and System.IO.Hashing only). The Jakar.Extensions parts moved to the new Jakar.Logging.Serilog: LogEventProperties (AppInformation/ThreadInformation/GcInfo/DeviceInformation properties), DeviceInformationEnricher, OpenTelemetryActivityEnricher (app and device properties from a TelemetrySource) and AppLoggerOptions.CreateLogger(TelemetrySource). Here: ActivityEnricher (spans, plus thread and GC state from RuntimeProperties on warnings) replaces OpenTelemetryActivityEnricher; IOpenTelemetryActivityEnricher is gone. AppLoggerOptions is no longer a BaseClass or disposable, has no DeviceInfo/Info, uses string paths (AppDataDirectory, CacheDirectory, LogsDirectory, SeqBuffer, LogsFile, ScreenshotFile) instead of LocalDirectory/FilePaths, CreateLogger(Action&lt;LoggerConfiguration&gt;?) replaces CreateLogger(TelemetrySource), and ConfigureLogger no longer takes a TelemetrySource; the folder/template constants are on AppLoggerOptions. ScreenShot.File is a path. Enricher lost its AppVersion/GcGenerationInformation overloads. 10.1.0: initial release. Split out of Jakar.Extensions 10.12.0; the types keep the Jakar.Extensions namespace.</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Jakar510/Jakar.Logging</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Jakar510/Jakar.Logging</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591;IDE0079;CS8424;IDE0046;CS1658</NoWarn>
		<WarningsAsErrors>Nullable;CS0114;CS9113;IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2111;IL3050;IL3051</WarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Formatting.Compact" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Jakar.Logging.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>